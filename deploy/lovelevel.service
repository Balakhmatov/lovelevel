[Unit]
Description=LoveLevel standalone dating application
After=network.target

[Service]
Type=simple
User=lovelevel
Group=lovelevel
WorkingDirectory=/opt/lovelevel/current
EnvironmentFile=/etc/lovelevel/app.env
Environment=NODE_ENV=production
Environment=PORT=3118
Environment=DATA_DIR=/var/lib/lovelevel
ExecStart=/usr/local/bin/node-lovelevel --experimental-sqlite /opt/lovelevel/current/server/index.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lovelevel
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
