PUBLIC_ORIGIN=https://lovelevel.cityai.site
# Off until data migration and owner sign-in have been verified.
ALLOW_REGISTRATION=false
# Optional shared invitation code, stored here only on VPS (0600), never in Git.
INVITE_CODE=
# Stable account IDs only; email addresses do not grant moderation rights.
ADMIN_USER_IDS=

# Use a dedicated secret in /etc/lovelevel/app.env on the VPS; never commit the value.
OPENAI_API_KEY=
MATCHLOVE_AI_MODEL=gpt-4.1-mini
MATCHLOVE_EMBEDDING_MODEL=text-embedding-3-small
